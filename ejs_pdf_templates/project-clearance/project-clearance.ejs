<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .container {
      margin: 0rem auto;
      padding: 15px 55px 30px 55px;
      font-size: 13px;
    }

    .header-content {
      font-weight: 600;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .applicant-info {
      padding: 0.8rem 0rem;
      font-weight: 600;
      line-height: 1.4;
    }

    .subject {
      font-weight: 600;
      font-size: 13.5px;
    }

    .main-content {
      margin: 1rem 0rem;
      line-height: 1.4;
      text-align: justify;
    }

    .reciver {
      margin: 1rem 0rem 0.5rem 0rem;
    }

    .conditions-part-1 {
      list-style-type: decimal-leading-zero;
      line-height: 1.4;
      margin: 1rem 0rem 0rem 1.5rem;
    }

    .conditions-part-1 li {
      margin-bottom: 0.5rem;
    }

    footer {
      display: -webkit-box;
      display: -ms-flexbox;
      display: flex;
      -webkit-box-pack: justify;
      -ms-flex-pack: justify;
      justify-content: space-between;
      -webkit-box-align: center;
      -ms-flex-align: center;
      align-items: center;
      width: 100%;
      margin-top: 1.55rem;
      overflow: auto;
    }

    footer .footer-items1 {
      width: 30%;
      text-align: center;
    }

    footer .footer-items1 img {
      width: 50%;
    }

    footer .footer-items1 .copy-for {
      text-align: left;
      line-height: 1.8;
    }

    footer .footer-items2 {
      width: 20%;
      text-align: center;
    }

    footer .footer-items3 {
      width: 40%;
      text-align: center;
    }

    footer .footer-items3 img {
      width: 60%;
    }

    .table-section {
      margin-top: 2rem;
    }

    table.GeneratedTable {
      width: 100%;
      background-color: transparent;
      border-collapse: collapse;
      margin: 0 auto !important;
      border: 1px solid rgba(53, 62, 108, 0.1) !important;
      border-radius: 4px !important;
      font-size: 12px;
    }

    table.GeneratedTable td,
    table.GeneratedTable th {
      border: 1px solid rgba(53, 62, 108, 0.1) !important;
    }

    table.GeneratedTable thead {
      background-color: transparent;
    }

    /* customize table */

    .second-page {
      margin-top: 2.5rem;
    }

    .child-td {
      padding: 0rem !important;
      border: none !important;
    }

    .child-td tr {
      text-align: center;
    }

    .child-tbody td {
      padding: 1rem 0rem !important;
    }

    th {
      padding: 1px 2px;
      text-align: left;
      background-color: #353e6c0d !important;
      color: #353e6c !important;
      font-weight: 700 !important;
    }

    td {
      padding: 1px 2px;
      font-weight: 500 !important;
      color: #353e6c !important;
      page-break-inside: avoid !important;
    }

    .first-th {
      width: 30% !important;
    }

    .second-th {
      width: 15% !important;
    }

    .third-th {
      width: 20% !important;
    }

    .fourth-th {
      width: 10% !important;
    }

    .fifth-th {
      width: 5% !important;
    }

    .sixth-th {
      width: 5% !important;
    }

    .first-td {
      text-align: center;
      line-height: 2;
    }

    .first-th-an1 {
      width: 34% !important;
    }

    .second-th-an2 {
      width: 33% !important;
    }

    .third-th-an3 {
      width: 33% !important;
    }

    .annexure-table-headers {
      height: 30px;
      background-color: #353e6c;
      color: #ffffff;
      border-radius: 4px;
      width: 100%;
      line-height: 29px;
      font-weight: 400;
      padding-left: 8px;
      margin-bottom: 8px;
    }

    .annexure-th {
      background-color: #353e6c0d;
      color: #353e6c;
      font-weight: 700;
      line-height: 16px;
    }

    .annexure-1-margin {
      margin-bottom: 1rem !important;
    }
  </style>
</head>

<body>
  <div class="container">
    <header>
      <div class="header-content">
        <p>
          Tracking No: <%= formValue.utils.parseFormValue(formValue.trackingId) %>
        </p>
        <div>
          <p>
            Date: <%= formValue.utils.parseFormValue(formValue.certificateGenerateDate) %>
          </p>
          <p>
            <%= formValue.utils.parseFormValue(formValue.lastAmendmentDate) %>
          </p>
        </div>
      </div>
    </header>
    <section class="applicant-info">
      <p>Managing Director/ CEO</p>
      <p>
        <%= formValue.utils.parseFormValue(formValue.proposedProjectCompanyName) %>
      </p>
      <p>
        <%= formValue.utils.parseFormValue(formValue.plotAddress) %>
      </p>
      <p>
        <%= formValue.utils.parseFormValue(formValue.economicZoneAddress) %>
      </p>
    </section>
    <article class="subject">
      <p>
        Subject: Approval for setting up a(n) <% if(formValue && formValue?.typeOfBusinessIndustryOrServices &&
          Array.isArray(formValue?.typeOfBusinessIndustryOrServices)) {%>
          <%= formValue?.typeOfBusinessIndustryOrServices?.join(', ') %> <%} else
          {%> <%=
          formValue.utils.parseFormValue(formValue.typeOfBusinessIndustryOrServices)
          %> <%}%> in <%= formValue.utils.parseFormValue(formValue.economicZone)
          %>
        </p>
      </article>
      <main class="main-content">
        <p class="reciver">Dear MD/ CEO,</p>
        <p class="message">
          With reference to your Project Proposal received on <%=
          formValue.utils.parseFormValue(formValue.applicationDate) %>, this is
          to inform you that the Authority is pleased to issue this clearance
          subject to approval from competent authorities and compliance of all
          legal requirements of your project for setting up a(n)
          <b>
            <%=
            formValue.utils.parseFormValue(formValue.typeOfBusinessIndustryOrServices)
            %> in <%=
            formValue.utils.parseFormValue(formValue.economicZoneAddress) %>
          </b>
          on terms and conditions as indicated below:
        </p>
        <ol type="1" class="conditions-part-1">
          <li>
            Name of the project:
            <b
              ><%=
              formValue.utils.parseFormValue(formValue.proposedProjectCompanyName)
              %></b
            >
          </li>
          <li>
            Products: <%=
            formValue.utils.parseFormValue(formValue.aNameDescriptionOfTheProductS)
            %>
          </li>
          <li>
            Cost of the project:
            <b
              ><%=
              formValue.utils.parseFormValue(formValue.dCostOfTheProjectInUs) %>
              Million USD</b
            >
          </li>
          <li>
            Type of Investment: <%=
            formValue.utils.parseFormValue(formValue.hiddenExportValue) %>%
            Export Orient<br /><span style="margin-left: 108px"
              ><%= formValue.utils.parseFormValue(formValue.hiddenDomesticValue)
              %>% Domestic Orient</span
            >
          </li>
          <li>
            Type of Industry: <%=
            formValue.utils.parseFormValue(formValue.typeOfIndustry) %>
          </li>
          <li>
            Annual production capacity: <%=
            formValue.utils.parseFormValue(formValue.productionCapacityHidden)
            %>
          </li>
          <li>
            Employment: <%=
            formValue.utils.parseFormValue(formValue.grandTotalSummation) %>
            persons including <%=
            formValue.utils.parseFormValue(formValue.foreigenTotalSummation) %>
            foreign nationals
          </li>
          <li>
            Status of the Company: <%=
            formValue.utils.parseFormValue(formValue.typeOfOrganization) %>
          </li>
          <li>
            Manufacturing Process: <%=
            formValue.utils.parseFormValue(formValue.cManufacturingProcess) %>
          </li>
          <!-- textField52 is for area -->
          <li>
            Area of land/SFB to be allotted: <%=
            formValue.utils.parseFormValue(formValue.agreedLandByDevelopersSqm)
            %> Square Meters plot in <%=
            formValue.utils.parseFormValue(formValue.plotAddress) %> at <%=
            formValue.utils.parseFormValue(formValue.specifyAreaOfMouza) %>
          </li>
          <!-- localTotal4 is for Local Machineries and Equipment -->
          <li>
            Machinery and equipments required to be imported for the project
            valued approximately at <%=
            formValue.utils.parseFormValue(formValue.machineryCurrencyValue) %>
            <%= formValue.utils.parseFormValue(formValue.machineryCurrency) %>
            only on the terms and conditions acceptable to this Authority.
          </li>

          <!-- New Page in Old PDF -->

          <li>
            Machinery to be imported for the project (as per list enclosed with
            the Project Proposal) shall be New. However, the import of old or
            used Machinery and equipment is allowed upon the fulfillment of the
            conditions laid down in the import Policy Order. Prior approval of
            the Authority shall be required for the import/shipment of machinery
            from abroad.
          </li>
          <li>
            Before procurement of Machinery and building-materials from abroad
            you are required to submit 3 (three) sets of price quotations from
            reputed machinery suppliers or in case of procurement of machinery
            from manufacturer, 1 (one) set of price quotation along with
            catalogues etc. of the machinery for approval of the Authority.
          </li>
          <li>
            The company will have to:
            <ol type="a" style="margin-top: 0.5rem">
              <li>
                maintain the ratio of export and domestic sale within <%=
                formValue.utils.parseFormValue(formValue.hiddenExportValue)
                %>:<%=
                formValue.utils.parseFormValue(formValue.hiddenDomesticValue) %>
                of entire product of its factory;
              </li>
              <li>
                submit monthly reports to the Authority on the progress of
                implementation of the project;
              </li>
              <li>
                commission the project in the allotted land space within a
                period of twelve months failing which the Authority may revoke
                this permission;
              </li>
              <li>
                furnish such other data on the project to this Authority and to
                any other agency as may be required;
              </li>
              <li>
                obtain work permits / permission of the Authority prior to entry
                for any foreign nationals on employment in the project;
              </li>
              <li>
                submit to this Authority, the audited Financial Statement for
                every financial year within 4(four) months from the closure of
                each financial year of the company;
              </li>
              <li>
                comply with the provisions of minimum wages of the workers as
                declared by the government from time to time and the EPZ Workers
                Welfare Association and Industrial Relations Act, 2010 (Act
                no-43 of 2010) (as amended from time to time by the Authority)
                in regards to wages, employment, salary, leave, discipline,
                health, compensation, insurance and other benefits to the
                employees engaged for work in your enterprise;
              </li>
              <li>
                comply with the rules pertaining to environment protection,
                pollution control and effluent treatment and take necessary
                safety measures against possible fire hazards;
              </li>
              <li>
                comply with all laws, by-laws, rules, regulations, directives of
                the government and of this Authority which are in force or which
                may be issued from time to time in future;
              </li>
              <li>
                comply with provisions of the “Principles and Procedures
                Governing Setting up of Industries in EZ”;
              </li>
              <li>
                obtain prior approval of the Authority in case the company
                decides to appoint a Managing Agent or transfer the shares of
                the company;
              </li>
              <li>
                the company shall have to submit actual Investment, export,
                domestic sales, employment information to the Authority and/ or
                with other government agency(s) in quarterly basis.
              </li>
            </ol>
          </li>
          <li>
            The construction of the factory building and other civil
            construction shall have to commence immediately and not later than
            03 (three) months from the date of issuance of this letter and will
            have to start commercial production within 01(one) year from the
            date of signing the land lease agreement. If the company fails to
            start construction work of factory building within 03(three) months,
            the land lease agreement may be terminated without issuance of any
            further notice. The building shall conform to the conditions and
            specification laid down in Bangladesh Economic Zones (Construction
            of Building ) Rules , 2017. Prior approval of the building plan has
            to be obtained from the Authority
          </li>
          <li>
            The company shall bear the cost of Services and Regulatory permit
            fees as prescribed by the Authority from time to time
          </li>
          <li>
            No waste/old materials will be allowed to import as raw materials.
          </li>
          <li>
            In the event of your failure to set up the unit within the
            stipulated time or infringement of any rules and regulations or
            violation of any of the above terms and conditions, the Authority
            may revoke the permiss
          </li>
          <li>This permission is not transferable.</li>
          <li>
            This permission is valid until expiration of the License awarded by
            Bangladesh Economic Zones Authority.
          </li>
          <li>
            If you agree with the terms and conditions contained in this letter
            along with those contained in the BEZA Act, Rules, Policies,
            Guidelines, SROs, Circulars, Office orders etc. you are requested to
            proceed for signing the land lease agreement with the Developer/
            Operator of with intimation to the Authority. Thanking and assuring
            you of our best cooperation at all times.
          </li>
        </ol>
      </main>
      <footer>
        <div class="footer-items1">
          <img src="<%= formValue.qrcode %>" alt="" />
          <p>Copy for Information to</p>
          <div class="copy-for">
            <p>
              a. <%= formValue.utils.parseFormValue(formValue.userDesignation)
              %>,
            </p>
            <p>b. Commissioner, Customer Bond...</p>
            <p>c. ..............................</p>
            <p>d. ..............................</p>
          </div>
        </div>
        <div class="footer-items2">
          <p><%- formValue.barcode %></p>
        </div>
        <!-- <div class="footer-items3">
          <h3>Yours faithfully</h3>
          <%- formValue.deskUserSignature %>
          <p style="font-weight: bold"><%= formValue.deskUserFullName %></p>
          <p style="font-weight: bold"><%= formValue.deskUserDesignation %></p>
          <p>Bangladesh Economic Zones Authority (BEZA)</p>
        </div> -->
      </footer>
      <div
        style="
          text-align: center;
          background: #dfbdcd;
          padding: 24px 0 24px 0;
          font-weight: 600;
          color: rgb(171, 34, 34);
          margin-top: 12px;
          opacity: 0.8;
        "
      >
        <p>
          THIS IS A COMPUTER GENERATED PERMIT. SO SIGNATURE IS NOT REQUIRED.
        </p>
      </div>
      <section class="table-section">
        <div class="annexure-table-headers">Annexure - 1</div>
        <div class="annexure-1-margin">
          <table class="GeneratedTable">
            <thead>
              <tr>
                <th class="first-th-an1">Infrastucture</th>
                <th class="second-th-an1">Initial Period</th>
                <th class="third-th-an1">
                  Regular Operation Period at maximum capacity
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Power (in KW/H)</td>
                <td>
                  <%= formValue.utils.parseFormValue(formValue.textField2) %>
                </td>
                <td>
                  <%= formValue.utils.parseFormValue(formValue.textField3) %>
                </td>
              </tr>
              <tr>
                <td>GAS (in M3) Per day</td>
                <td>
                  <%= formValue.utils.parseFormValue(formValue.textField4) %>
                </td>
                <td>
                  <%= formValue.utils.parseFormValue(formValue.textField5) %>
                </td>
              </tr>
              <tr>
                <td>Water (in M3) Per day</td>
                <td>
                  <%= formValue.utils.parseFormValue(formValue.textField6) %>
                </td>
                <td>
                  <%= formValue.utils.parseFormValue(formValue.textField7) %>
                </td>
              </tr>
              <tr>
                <td>Central ETP (in M3) Per day</td>
                <td>
                  <%= formValue.utils.parseFormValue(formValue.textField8) %>
                </td>
                <td>
                  <%= formValue.utils.parseFormValue(formValue.textField9) %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="annexure-table-headers">Annexure - 2</div>
        <div>
          <table class="GeneratedTable">
            <thead>
              <tr>
                <th class="first-th">Details of Machinery</th>
                <th class="second-th">Country of Origin</th>
                <th class="third-th">Name of The vendor</th>
                <th class="fourth-th">Value</th>
                <th class="fifth-th">Value Currency</th>
                <th class="sixth-th">State</th>
              </tr>
            </thead>
            <tbody>
              <% formValue.machineriesToCalculate.forEach((element, i) => {%>
              <tr>
                <td>
                  <%= formValue.utils.parseFormValue(element.detailsOfMachinery)
                  %>
                </td>
                <td>
                  <%= formValue.utils.parseFormValue(element.coountryOfOrigin)
                  %>
                </td>
                <td>
                  <%= formValue.utils.parseFormValue(element.nameOfTheVendor) %>
                </td>
                <td>
                  <%=
                  formValue.utils.parseFormValue(formValue.utils.numberWithCommas(element.valueInput))
                  %>
                </td>
                <td>
                  <%= formValue.utils.parseFormValue(element.valueCurrency) %>
                </td>
                <td>
                  <%= formValue.utils.parseFormValue(element.materialState) %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </body>
</html>