<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>

    <style>
      .body {
        padding: 0 35px 65px 35px;
        font-size: 9px;
      }

      .title {
        text-align: center;
        font-size: 18px;
        font-weight: 600;
        padding-bottom: 20px;
      }

      .sub-title {
        font-size: 18px;
        font-weight: 500;
      }

      .table {
        border: 1px solid #e2e0df;
        border-right-width: 0;
        border-bottom-width: 0;
      }

      .table_row {
        display: flex;
        flex-direction: row;
      }

      .table_row_cell,
      .table_row_cell_width {
        border: 1px solid #e2e0df;
        border-left-width: 0;
        border-top-width: 0;
        padding: 4px;
      }
      .table_row_cell_width {
        width: 14.2857%;
      }
      .value {
        letter-spacing: 0.25;
        padding: 0 1px;
      }
    </style>
  </head>

  <body>
    <div class="body">
      <div class="title">
        <p>Addition Of Machinery List</p>
      </div>
      <div class="sub-title">
        <p>Annexure - 1</p>
      </div>
      <div>
        <div class="table">
          <div class="table_row">
            <div class="table_row_cell_width">
              <p class="value">Details of Machinery</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">Country of Origin</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">Name of The Vendor</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">Value</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">Value Currency</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">State</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">IF old, how old?(Year)</p>
            </div>
          </div>
        </div>

        <div class="table">
          <% formValue.additionOfMachinery.forEach(function (machinery) { %>

          <div class="table_row">
            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.detailsOfMachinery) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.coountryOfOrigin) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.nameOfTheVendor) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.valueInput) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.valueCurrency) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.materialState) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value"></p>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </body>
</html>
