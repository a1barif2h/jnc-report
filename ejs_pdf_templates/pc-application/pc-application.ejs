<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>

    <style>
      .body {
        padding: 0 35px 65px 35px;
        font-size: 9px;
      }

      .header {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 24px;
      }

      .header p {
        margin: 0;
        margin-bottom: 8px;
        text-align: center;
      }

      .img-container {
        width: 60px;
      }

      .img-container img {
        width: 100%;
      }

      .title {
        text-align: center;
        font-size: 18px;
        font-weight: 600;
        padding-bottom: 20px;
      }

      .sub-title {
        font-size: 22px;
        font-weight: 500;
      }

      .table {
        border: 1px solid #e2e0df;
        border-right-width: 0;
        border-bottom-width: 0;
      }

      .table_row {
        display: flex;
        flex-direction: row;
      }

      .table_row_cell,
      .table_row_cell_width {
        border: 1px solid #e2e0df;
        border-left-width: 0;
        border-top-width: 0;
        padding: 4px;
      }
      .table_row_cell_width {
        width: 14.2857%;
      }
      .value {
        letter-spacing: 0.25;
        padding: 0 1px;
      }
    </style>
  </head>

  <body>
    <div class="body">
      <!-- <div class="title">
        <p>Addition Of Machinery List</p>
      </div> -->
      <div class="sub-title">
        <p>Annexure - 1</p>
      </div>
      <div class="header">
        <div class="img-container">
          <img
            src="data:image/png;base64,"
            alt=""
            srcset=""
          />
        </div>
        <div class="title-container">
          <p>BEZA::Bangladesh Economic Zones Authority</p>
          <p style="font-weight: 500; font-size: 16px; margin-bottom: 0">
            Application for <%= applicationTitle %>
          </p>
        </div>
      </div>
      <div
        style="
          display: flex;
          justify-content: space-between;
          flex-direction: row;
          border: 1px solid #325a77;
          padding-left: 2px;
          padding-right: 2px;
          font-weight: 600;
          margin-bottom: 24px;
        "
      >
        <div style="display: flex; flex-direction: row">
          <p style="font-size: 10px; font-family: 'Times-Bold'">
            Tracking ID :
          </p>
          <p style="font-size: 10px; font-family: 'Times-Roman'">
            <%= trackingId %>
          </p>
        </div>

        <% if (doeFileId) { %>
        <div style="display: flex; flex-direction: row">
          <p style="font-size: 10px; font-family: 'Times-Bold'">
            DOE File No.:
          </p>
          <p style="font-size: 10px; font-family: 'Times-Roman'">
            <%= doeFileId %>
          </p>
        </div>
        <% } %>

        <div style="display: flex; flex-direction: row">
          <p style="font-size: 10px; font-family: 'Times-Bold'">
            Submitted At :
          </p>
          <p style="font-size: 10px; font-family: 'Times-Roman'">
            <%= submittedDate ? utils.formatDate(submittedDate, "dd MMM yyyy") :
            "..." %>
          </p>
        </div>

        <div style="display: flex; flex-direction: row">
          <p style="font-size: 10px; font-family: 'Times-Bold'">
            Current Status :
          </p>
          <p style="font-size: 10px; font-family: 'Times-Roman'">
            <%= currentStatus %>
          </p>
        </div>

        <div style="display: flex; flex-direction: row">
          <p style="font-size: 10px; font-family: 'Times-Bold'">
            Current Desk :
          </p>
          <p style="font-size: 10px; font-family: 'Times-Roman'">
            <%= currentDesk %>
          </p>
        </div>
      </div>

      <div
        style="
          background-color: #325a77;
          color: #ffffff;
          padding: 8px;
          font-size: 16px;
          font-weight: 600;
          margin-bottom: 4px;
        "
      >
        <p style="margin: 0">12. Machinery</p>
      </div>

      <div>
        <div class="table">
          <div class="table_row">
            <div class="table_row_cell_width">
              <p class="value">Details of Machinery</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">Country of Origin</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">Name of The Vendor</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">Value</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">Value Currency</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">State</p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">IF old, how old?(Year)</p>
            </div>
          </div>
        </div>

        <div class="table">
          <% formValue.additionOfMachinery.forEach(function (machinery) { %>

          <div class="table_row">
            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.detailsOfMachinery) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.coountryOfOrigin) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.nameOfTheVendor) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.valueInput) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.valueCurrency) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value">
                <%= utils.parseFormValue(machinery.materialState) %>
              </p>
            </div>

            <div class="table_row_cell_width">
              <p class="value"></p>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </body>
</html>
