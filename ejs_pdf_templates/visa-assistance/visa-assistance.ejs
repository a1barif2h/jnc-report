<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Merriweather:wght@300&display=swap"
      rel="stylesheet"
    />
    <title>Certificate</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      .container {
        padding: 5px 55px 0 55px;
        font-size: 13px;
        font-family: "EB Garamond", serif;
        text-align: justify;
      }

      header {
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-pack: justify;
        -ms-flex-pack: justify;
        -webkit-box-align: center;
        -ms-flex-align: center;
        align-items: center;
        justify-content: space-between;
        width: 100%;
      }

      .header-logo img {
        width: 160px;
      }

      .header-qr-code img {
        width: 70px;
      }

      .application-date b {
        display: block;
      }

      .application-date {
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-pack: justify;
        -ms-flex-pack: justify;
        justify-content: space-between;
        margin: 1.2rem 0rem;
      }

      .application-subject {
        margin: 1.2rem 0rem 0.2rem 0rem;
      }

      .application-header {
        margin-top: 1rem;
      }

      .application-header .dear-ceo {
        margin: 0.7rem 0rem;
      }

      .application-header-text {
        margin: 0.3rem 0rem;
        line-height: 1.5;
      }

      .application-info {
        margin-top: 1.2rem;
      }

      .application-list {
        line-height: 1.5;
      }

      .application-ambassador {
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-pack: justify;
        -ms-flex-pack: justify;
        justify-content: space-between;
        -webkit-box-align: end;
        -ms-flex-align: end;
        align-items: flex-end;
        line-height: 1.5;
      }

      .application-ambassador .signature-container {
        width: 70%;
        display: flex;
        align-items: center;
        justify-content: flex-end;
      }

      .application-ambassador .signature {
        text-align: center;
      }

      .application-ambassador .signature img {
        width: 50%;
      }

      .application-ambassador .signature hr {
        border: 0;
        border-bottom: 1.5px solid rgb(46, 45, 45);
        width: 60%;
        margin: 5px auto;
      }

      .application-ambassador .signature .desk-user {
        font-weight: 700;
      }

      .cc {
        margin-top: 1.2rem;
        line-height: 2;
      }
      header .header-bar-code img {
        width: 30%;
      }

      footer p {
        line-height: 1.5;
        margin-top: 1.2rem;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <main>
        <div class="application-date">
          <div>
            <b
              >Tracking No:<%=
              formValue.utils.parseFormValue(formValue.trackingId ) %></b
            >
          </div>
          <div>
            <b
              >Date: <%=
              formValue.utils.parseFormValue(formValue.certificateGenerateDate )
              %></b
            >
            <b
              ><%= formValue.utils.parseFormValue(formValue.lastAmendmentDate )
              %></b
            >
          </div>
        </div>

        <div class="application-subject">
          <b>Subject: Request for Issuance of visa </b>
        </div>
        <div class="application-header">
          <p class="dear-ceo">Dear Sir,</p>
          <p class="application-header-text">
            With reference to the above mentioned subject, it is to inform you
            that <%=
            formValue.utils.parseFormValue(formValue.proposedProjectCompanyName
            ) %> is working / willing to work with the Bangladesh Economic Zone
            Authority. The Company has requested for visa recommendation for the
            following expatriate:
          </p>
        </div>

        <div class="application-list">
          <div>
            <p>
              <b style="width: 20%; display: inline-block">Name </b
              ><b
                >: <%=
                formValue.utils.parseFormValue(formValue.nameOfTheForeignNational
                ) %></b
              >
            </p>
            <p>
              <b style="width: 20%; display: inline-block">Nationality</b
              ><b
                >: <%=
                formValue.utils.parseFormValue(formValue.particularsNationality
                ) %></b
              >
            </p>
            <p>
              <b style="width: 20%; display: inline-block">Passport No. </b
              ><b
                >: <%= formValue.utils.parseFormValue(formValue.passport1 )
                %></b
              >
            </p>
            <p>
              <b style="width: 20%; display: inline-block"
                >Type of Visa Required </b
              ><b
                >: <%=
                formValue.utils.parseFormValue(formValue.typeOfVisaObtainedForTheIncumbentForeignNationals
                ) %></b
              >
            </p>
          </div>
          <div></div>
        </div>

        <div class="application-info">
          <p class="application-header-text">
            It would be highly appreciated if you would kindly issue the desired
            in favour of the above-mentioned national on proper verification of
            the papers upon submission of application for the same.
          </p>
        </div>
        <div class="application-ambassador">
          <div>
            <p>The High Commissioner/ Ambassador</p>
            <p style="font-size: 11px">
              High Commission/ Embassy of the People's Republic of Bangladesh
            </p>
            <p>
              <%= formValue.utils.parseFormValue(formValue.embassyHighCommission
              ) %>.
            </p>
          </div>
          <!-- <div class="signature-container">
            <div class="signature">
              <h3>Yours faithfully</h3>
              <%- formValue.deskUserSignature %>
              <hr />
              <div class="desk-user">
                <p>
                  <%= formValue.utils.parseFormValue(formValue.deskUserFullName)
                  %>
                </p>
                <p>
                  <%=
                  formValue.utils.parseFormValue(formValue.deskUserDesignation)
                  %>
                </p>
              </div>
              <div>Bangladesh Economic Zones Authority</div>
            </div>
          </div> -->
        </div>
        <div class="cc">
          <b>CC To.</b>
          <p>For kind information and necessary action:</p>
          <p>
            1. Senior Secretary, Ministry of Home Affairs, Bangladesh
            Secretariat, Dhaka
          </p>
          <p>
            2. Director General, Department of Immigration and Passport, Dhaka.
          </p>
          <p>3. ..............................................</p>
          <p>4. ..............................................</p>
          <p>5. ..............................................</p>
        </div>
      </main>
      <footer>
        <p>
          The above mentioned foreign national may be advised to approach in
          Embassy/ High Commission of Bangladesh in <%=
          formValue.utils.parseFormValue(formValue.country4 ) %> with the copy
          of his appointment letter or other related documents for obtaining
          Visa. The company shall be responsible for all action of the
          expatriate during his/ her stay in Bangladesh.
        </p>
      </footer>
      <div
        style="
          text-align: center;
          background: #dfbdcd;
          padding: 24px 0 24px 0;
          font-weight: 600;
          color: rgb(171, 34, 34);
          margin-top: 12px;
          opacity: 0.8;
        "
      >
        <p>
          THIS IS A COMPUTER GENERATED PERMIT. SO SIGNATURE IS NOT REQUIRED.
        </p>
      </div>
    </div>
  </body>
</html>
