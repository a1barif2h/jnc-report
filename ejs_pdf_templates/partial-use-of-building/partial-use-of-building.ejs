<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>Certificate</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .container {
            margin: 1.5rem auto;
            padding: 10px 55px;
            font-size: 14px;
            text-align: justify;
        }

        .import-permit {
            height: 2.5rem;
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            justify-content: center;
            background-color: #008000;
            font-size: 20px;
            letter-spacing: 0.5px;
            margin-top: 1.5rem;
            color: white;
        }


        .header-img {
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-box-pack: justify;
            -ms-flex-pack: justify;
            justify-content: space-between;
        }

        header .header-bar-code {
            margin-left: 10;
        }

        header .header-bar-code img {
            width: 30%;
        }

        header .header-logo img {
            width: 160px;
        }

        .application-date {
            margin: .6rem 0rem;
            font-weight: bolder;
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-pack: justify;
            -ms-flex-pack: justify;
            justify-content: space-between;
            line-height: 1.4;
            font-size: 13px;
        }

        .application-date-title {
            font-weight: 500;
        }

        .modification-description {
            margin-top: 15px;
        }

        .modification-description>.modification-description-title {
            font-size: 18px;
            text-decoration: underline;
            font-weight: 700;
            line-height: 1.5;
        }

        .modification-description>.modification-description-details {
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: start;
            -ms-flex-align: start;
            align-items: start;
            -webkit-box-pack: justify;
            -ms-flex-pack: justify;
            justify-content: space-between;
            line-height: 1.4;
            font-size: 13px;
            font-weight: 600;
        }

        .modification-description>.modification-description-details>.details-left {
            width: 70%;
        }

        .modification-description>.modification-description-details>.details-right {
            width: 30%;
        }

        .modification-description>.modification-description-details .detail {
            font-weight: 500;
        }

        .permission-container {
            margin-top: 20px;
            line-height: 1.8;
        }

        .permission-container>.permission-container-title {
            text-align: center;
            color: #348a5b;
            font-size: 22px;
            margin-bottom: 15px;
            font-weight: 600;
        }

        hr {
            width: 380px;
            border: 0;
            border-bottom: 1px solid black;
            margin: auto;
            margin-top: -18px;
            margin-bottom: 25px;
        }

        .permission-container>.permission-declaration {
            line-height: 1.6;
            font-weight: 400;
        }

        .declaration-bold {
            font-weight: 600;
        }

        .footer-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            align-items: center;
            width: 100%;
            margin-top: 45px;
        }

        .footer-container .qr-code {
            width: 40%;
        }

        .footer-container .qr-code img {
            width: 50%;
        }

        .footer-container .signature-container {
            width: 70%;
            display: flex;
            align-items: center;
            justify-content: flex-end;
        }

        .footer-container .signature {
            text-align: center;
        }

        .footer-container .signature img {
            width: 50%;
        }

        .footer-container .signature hr {
            border: 0;
            border-bottom: 1.5px solid rgb(46, 45, 45);
            width: 60%;
            margin: 5px auto;
        }

        .footer-container .signature .desk-user {
            font-weight: 700;
        }

        .application-list {
            list-style: none;
        }

        .terms-condition small {
            display: block;
            margin: 6px 10px;
        }

        .building-information {
            margin-left: 10px;
        }
    </style>

<body>
    <div class="container container-page-break">
        <header>
            <div class="import-permit">
                <h3>Partial Use of Building Permit</h3>
            </div>
            <div class="application-date">
                <div>
                    <p>Tracking no: <span class="application-date-title">
                            <%= formValue.utils.parseFormValue(formValue.trackingId)%>
                        </span></p>
                    <p>Company Name: <span class="application-date-title">
                            <%= formValue.utils.parseFormValue(formValue.proposedProjectCompanyName)%>
                        </span></p>
                    <p>Economic Zone: <span class="application-date-title">
                            <%= formValue.utils.parseFormValue(formValue.economicZoneAddress)%>
                        </span></p>
                </div>
                <div>
                    <p>Issue Date: <%= formValue.utils.parseFormValue(formValue.certificateGenerateDate)%>
                    </p>
                    <p>
                        <%= formValue.utils.parseFormValue(formValue.lastAmendmentDate)%>
                    </p>
                </div>
            </div>
            <div class="modification-description">
                <p class="modification-description-title">Content of the Partial use of the building: </p>
                <div class="modification-description-details">
                    <div class="details-left">
                        <p>Building Permit no: <span class="detail">
                                <%= formValue.utils.parseFormValue(formValue.buildingPermitNo)%>
                            </span></p>
                        <p>Period of Partial Use: <span class="detail">From <%=
                                    formValue.utils.parseFormValue(formValue.prriodOfPartialUseForm)%> to <%=
                                        formValue.utils.parseFormValue(formValue.periodOfPartialUseTo)%></span></p>
                        <p>Reason of Partial Use: <span class="detail">
                                <%= formValue.utils.parseFormValue(formValue.reasonOfPartialUse)%>
                            </span></p>
                    </div>
                    <div class="details-right"></div>
                </div>
            </div>
        </header>
        <main>
            <div class="permission-container">
                <p class="permission-container-title">Permission for Partial use of Building</p>
                <hr />
                <p class="permission-declaration">
                    With reference to the above-mentioned application, Building Committee reviewed and examined all the
                    documents and drawings submitted by <span class="declaration-bold">
                        <%= formValue.utils.parseFormValue(formValue.proposedProjectCompanyName)%>
                    </span> . The Committee found the conformity of all the drawings with the Bangladesh Economic Zones
                    (construction of Building) Rules, 2017 and the Bangladesh National Building Code 2020. Consequently,
                    BEZA-OSS Center hereby grants the partial use of building to <span class="declaration-bold">
                        <%= formValue.utils.parseFormValue(formValue.proposedProjectCompanyName)%>
                    </span> situated at <span class="declaration-bold">
                        <%= formValue.utils.parseFormValue(formValue.economicZoneAddress)%>
                    </span> From <%= formValue.utils.parseFormValue(formValue.prriodOfPartialUseForm)%> to <%=
                            formValue.utils.parseFormValue(formValue.periodOfPartialUseTo)%>
                </p>
            </div>
        </main>
        <footer>
            <div class="footer-container">
                <div class="qr-code">
                    <img src="<%= formValue.qrcode %>" alt="" />
                </div>

                <div class="signature-container">
                    <div class="signature">
                        <h3>Yours faithfully</h3>
                        <%- formValue.deskUserSignature %>
                            <hr />
                            <div class="desk-user">
                                <p>
                                    <%= formValue.utils.parseFormValue(formValue.deskUserFullName) %>
                                </p>
                                <p>
                                    <%= formValue.utils.parseFormValue(formValue.deskUserDesignation) %>
                                </p>
                            </div>
                            <div>Bangladesh Economic Zones Authority</div>
                    </div>
                </div>
            </div>
        </footer>
    </div>
</body>

</html>