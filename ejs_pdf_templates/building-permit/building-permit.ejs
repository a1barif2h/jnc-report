<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />
    <title>Certificate</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      .container {
        padding: 35px;
        font-size: 13px;
        text-align: justify;
      }

      .building-permit {
        font-size: 10px;
        background: #6cc050;
        color: white;
        height: 2.4rem;
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-pack: center;
        -ms-flex-pack: center;
        justify-content: center;
        -webkit-box-align: center;
        -ms-flex-align: center;
        align-items: center;
      }

      .application-date {
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-pack: justify;
        -ms-flex-pack: justify;
        justify-content: space-between;
        margin: 1rem 0rem;
        line-height: 1.6;
      }

      .reference-area p {
        margin: 0;
        line-height: 1.6;
      }

      .attention {
        margin: 8px 0;
      }

      .attention p {
        margin: 0;
        line-height: 1.6;
      }

      .cert-details p {
        margin: 0;
        line-height: 1.6;
      }

      .declaration-list {
        margin: 10px 0;
        line-height: 1.6;
      }

      .permit-condition {
        margin: 8px 0;
      }

      .condition,
      .inspections {
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
      }

      .condition-left {
        width: 40%;
      }

      .condition-right {
        width: 60%;
        font-size: 12px;
      }

      .inspections-left {
        width: 25%;
      }

      .secondPageContainer {
        margin: 0rem auto;
      }

      .footer-container {
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-pack: justify;
        -ms-flex-pack: justify;
        justify-content: space-between;
        -webkit-box-align: center;
        -ms-flex-align: center;
        align-items: center;
        width: 100%;
      }

      .footer-container .qr-code {
        width: 30%;
        text-align: center;
      }

      .footer-container .qr-code img {
        width: 50%;
      }

      .footer-container .signature {
        width: 50%;
        text-align: center;
      }

      .footer-container .signature img {
        width: 30%;
      }

      .footer-container .signature hr {
        border: 0;
        border-bottom: 1.5px solid rgb(46, 45, 45);
        width: 50%;
        margin: 5px auto;
      }

      .footer-container .signature .desk-user {
        font-weight: 700;
      }

      .factory {
        margin: 1rem 0rem -0.5rem 0rem;
        font-size: 8px;
        border-bottom: 1px solid black;
      }

      .sig_img {
        width: 100px;
      }

      .sig_img img {
        width: 100%;
      }

      /* UTILS CLASS */
      .fw-bold {
        font-weight: 600;
      }
      .fw-normal {
        font-weight: normal;
      }

      .mr-15 {
        margin-right: 15px;
      }
      .ml-24 {
        margin-left: 24px;
      }
      .ml-28 {
        margin-left: 28px;
      }

      .pl-10 {
        padding-left: 10px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <main>
        <div class="building-permit">
          <h1>BUILDING PERMIT</h1>
        </div>

        <div class="application-date">
          <div>
            <p>
              <span class="fw-bold">Tracking No:</span> <%=
              formValue.utils.parseFormValue(formValue.trackingId)%>
            </p>
          </div>
          <div>
            <p>
              <span class="fw-bold">Date:</span> <%=
              formValue.utils.parseFormValue(formValue.certificateGenerateDate)%>
            </p>
          </div>
        </div>

        <div class="reference-area fw-normal">
          <p>
            <span class="fw-bold">Your Reference:</span> Building Permit
            Application submitted by
            <span class="fw-bold"
              ><%=
              formValue.utils.parseFormValue(formValue.proposedProjectCompanyName)%></span
            >
            on
            <span class="fw-bold"
              ><%=
              formValue.utils.parseFormValue(formValue.applicationDate)%></span
            >.
          </p>
        </div>

        <div class="attention fw-normal">
          <p>
            <span class="fw-bold">Attention: </span><%=
            formValue.utils.parseFormValue(formValue.proposedProjectCompanyName)%>
          </p>
        </div>

        <div class="cert-details fw-normal">
          <p>
            With reference to the above-mentioned application, Building
            Committee reviewed and examined all the documents and drawings
            submitted by
            <span class="fw-bold"
              ><%=
              formValue.utils.parseFormValue(formValue.proposedProjectCompanyName)%></span
            >
            at the meeting held on
            <span class="fw-bold"
              ><%= formValue.utils.parseFormValue(formValue.meetingDate)%></span
            >
            The Committee found the conformity of all the drawings with the
            Bangladesh Economic Zones (construction of Building) Rules, 2017 and
            the Bangladesh National Building Code 2020. Consequently, BEZA-OSS
            Center hereby grants the Building Permit to
            <span class="fw-bold"
              ><%=
              formValue.utils.parseFormValue(formValue.proposedProjectCompanyName)%></span
            >
            located at
            <span class="fw-bold"
              ><%=
              formValue.utils.parseFormValue(formValue.economicZone)%></span
            >
            as under.
          </p>
        </div>

        <div class="declaration-list fw-normal">
          <div class="list">
            <ol type="I" style="margin-left: 16px">
              <li>
                Terms and Conditions for Approval:
                <ol type="i" style="margin-left: 24px">
                  <li>
                    This Building Permit shall be valid only for the factory
                    construction as under;
                    <div class="permit-condition">
                      <div class="condition pl-10">
                        <div class="condition-left">
                          Name of the Economic Zone
                        </div>
                        <div class="condition-right">
                          :<span class="fw-bold"
                            ><%=
                            formValue.utils.parseFormValue(formValue.economicZone)%></span
                          >
                        </div>
                      </div>

                      <div class="condition pl-10">
                        <div class="condition-left">Plot Number</div>
                        <div class="condition-right">
                          :<span class="fw-bold"
                            ><%=
                            formValue.utils.parseFormValue(formValue.plotAddress)%></span
                          >
                        </div>
                      </div>
                      <div class="condition pl-10">
                        <div class="condition-left">Land Area(sqm)</div>
                        <div class="condition-right">
                          :<span class="fw-bold"
                            ><%=
                            formValue.utils.parseFormValue(formValue.agreedLandByDevelopersSqm)%>
                            sqm</span
                          >
                        </div>
                      </div>

                      <div class="condition pl-10">
                        <div class="condition-left">No. of Building</div>
                        <div class="condition-right">
                          :<span class="fw-bold"
                            ><%=
                            formValue.utils.parseFormValue(formValue.numberOfBuildingInfo)%></span
                          >
                        </div>
                      </div>

                      <div class="condition pl-10">
                        <div class="condition-left">Building Area(sqm)</div>
                        <div class="condition-right">
                          :<span class="fw-bold"
                            ><%=
                            formValue.utils.parseFormValue(formValue.totalBuildingArea)%>
                            sqm</span
                          >
                        </div>
                      </div>

                      <div class="condition pl-10">
                        <div class="condition-left">Total Floor Area(sqm)</div>
                        <div class="condition-right">
                          :<span class="fw-bold"
                            ><%=
                            formValue.utils.parseFormValue(formValue.hiddenTotalFloorArea)%>
                            sqm</span
                          >
                        </div>
                      </div>
                    </div>
                  </li>
                  <li>
                    In case you make any modification by
                    adding/extending/deducing or in any other form to the
                    construction design or plan approved under this Building
                    Permit or if you intend to construct a factory in any place
                    other than the Specified Plot(<span class="fw-bold"
                      ><%=
                      formValue.utils.parseFormValue(formValue.economicZone)%></span
                    >), you shall be required to apply for a new Building Permit
                    to BEZA-OSS Center.
                  </li>
                  <li>
                    This Building Permit shall become invalid unless the
                    construction work on the permitted site commences within one
                    (1) year from the date of issuance, or if the construction
                    work permitted on the site is suspended or abandoned for a
                    period of one (1) year after the construction work has
                    commenced. For the extension of the validity period of this
                    Building Permit, a request letter shall be submitted to
                    BEZA-OSS Center with justifiable cause demonstrated.
                  </li>
                  <li>
                    You shall submit the application form with other required
                    documents for the Inspections to BEZA-OSS Center and receive
                    their inspections at each stage described below;
                    <ol type="1" style="margin-left: 8px">
                      <li>
                        <div class="inspections">
                          <div class="inspections-left">First Inspection</div>
                          <div class="inspections-right">
                            : at the stage of foundation work
                          </div>
                        </div>
                      </li>
                      <li>
                        <div class="inspections">
                          <div class="inspections-left">Second Inspection</div>
                          <div class="inspections-right">
                            : at the stage of structure framing work
                          </div>
                        </div>
                      </li>
                      <li>
                        <div class="inspections">
                          <div class="inspections-left">Final Inspection</div>
                          <div class="inspections-right">
                            : at the stage of completion of construction work
                          </div>
                        </div>
                      </li>
                    </ol>
                  </li>
                  <li>
                    If you fail to comply with the terms and conditions
                    stipulated herein, this Building Permit shall be cancelled.
                  </li>
                </ol>
              </li>
            </ol>
          </div>
        </div>

        <div class="secondPageContainer">
          <footer>
            <div class="footer-container">
              <div class="qr-code">
                <img src="<%= formValue.qrcode%>" alt="" />
              </div>

              <div class="signature">
                <h3>Yours faithfully</h3>
                <%- formValue.deskUserSignature%>
                <hr />
                <div class="desk-user">
                  <p>
                    <%=
                    formValue.utils.parseFormValue(formValue.deskUserFullName)%>
                  </p>
                  <p>
                    <%=
                    formValue.utils.parseFormValue(formValue.deskUserDesignation)%>
                  </p>
                </div>

                <div>Bangladesh Economic Zones Authority</div>
              </div>
            </div>
          </footer>
        </div>
      </main>
    </div>
  </body>
</html>
