<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      .container {
        margin: 0rem auto;
        padding: 5px 55px 0 55px;
      }

      .import-permit {
        height: 2.4rem;
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-align: center;
        -ms-flex-align: center;
        align-items: center;
        -webkit-box-pack: center;
        -ms-flex-pack: center;
        justify-content: center;
        background-color: red;
        font-size: 12px;
        letter-spacing: 0.5px;
        margin-top: 0.5rem;
        color: white;
        opacity: 0.8;
      }

      .import-date {
        font-size: 12.5px;
        font-weight: bold;
        margin: 0.6rem 0rem;
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-align: center;
        -ms-flex-align: center;
        align-items: center;
        -webkit-box-pack: justify;
        -ms-flex-pack: justify;
        justify-content: space-between;
      }

      .general-information,
      .material-details {
        height: 2.4rem;
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-align: center;
        -ms-flex-align: center;
        align-items: center;
        -webkit-box-pack: center;
        -ms-flex-pack: center;
        justify-content: center;
        font-size: 12px;
        letter-spacing: 0.5px;
        color: white;
        background-color: #278000;
        opacity: 0.8;
      }

      .border-box {
        display: flex;
        justify-content: space-between;
        border: 1.5px solid #278000;
        line-height: 1.8;
      }
      .left {
        width: 50%;
        padding: 5px 15px;
      }
      .right {
        width: 50%;
        padding: 5px 15px;
      }

      .general-item {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
      }

      .item-label {
        font-size: 10.5px;
        font-weight: bold;
        min-width: fit-content;
        max-width: 45%;
      }

      .item-value {
        width: auto;
        font-size: 11px;
      }

      .material-group {
        height: 2.4rem;
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-align: center;
        -ms-flex-align: center;
        align-items: center;
        -webkit-box-pack: center;
        -ms-flex-pack: center;
        justify-content: center;
        background-color: #353535;
        font-size: 12px;
        letter-spacing: 0.5px;
        margin-top: 1rem;
        color: white;
        opacity: 0.8;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="import-permit">
        <h3>EXPORT PERMIT</h3>
      </div>

      <div class="import-date">
        <p>
          Tracking No: <%=formValue.utils.parseFormValue(formValue.trackingId)
          %>
        </p>
        <div>
          <p>Date: <%= formValue.certificateGenerateDate %></p>
          <p><%= formValue.lastAmendmentDate %></p>
        </div>
      </div>

      <div class="general">
        <div class="general-information">
          <h3>GENERAL INFORMATION</h3>
        </div>

        <div class="border-box">
          <div class="left">
            <div class="general-item">
              <p class="item-label">Name of the Company:</p>
              <p class="item-value">
                <%=
                formValue.utils.parseFormValue(formValue.proposedProjectCompanyName)
                %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Export Permit Type:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.importPermitType)
                %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Carrier Name:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.carrierName) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Economic Zone:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.economicZone) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Undertaking No.:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.undertakingNo) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Invoice/ Vendor Reference No:</p>
              <p class="item-value">
                <%=
                formValue.utils.parseFormValue(formValue.invoiceVendorReferenceNo)
                %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">CM Value:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.cmCurrency) %> <%=
                formValue.utils.parseFormValue(formValue.cmCurrencyValue) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Port of Destination:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.portOfDestination)
                %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Destination Country:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.destinationCountry)
                %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Consignee Name :</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.consigneeName) %>
              </p>
            </div>

            <div class="general-item">
              <p class="item-label">Ship Number :</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.hiddenShipNumber)
                %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Remarks :</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.remarks) %>
              </p>
            </div>
          </div>
          <div class="right">
            <div class="general-item">
              <p class="item-label">Carrier Type:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.typeOfCarrier) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Name of Developer :</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.nameOfDeveloper) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Carrier Passport No:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.carrierPassportNo)
                %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Carrier Passport Validity:</p>
              <p class="item-value">
                <%=
                formValue.utils.parseFormValue(formValue.carrierPassportValidity)
                %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Undertaking Date:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.undertakingNo1) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Invoice/ Vendor Ref. Date:</p>
              <p class="item-value">
                <%=
                formValue.utils.parseFormValue(formValue.invoiceVendorRefDate)
                %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">
                <%= formValue.utils.parseFormValue(formValue.fobValue) %>:
              </p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.foBCurrency) %> <%=
                formValue.utils.parseFormValue(formValue.fobCurrencyValue) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Place of Load:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.placeOfLoad) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Destination Zone:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.destinationZone) %>
              </p>
            </div>
            <div class="general-item">
              <p class="item-label">Consignee Address:</p>
              <p class="item-value">
                <%= formValue.utils.parseFormValue(formValue.consigneeAddress)
                %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="material-description">
        <div class="material-group">
          <h3>Export Material & L/C Information Group</h3>
        </div>

        <% formValue.exportMaterialsInformationGroup.map((item) => { %>
        <div>
          <div class="material-details" style="margin-top: 1rem">
            <h3>Export Material Details</h3>
          </div>
          <div class="border-box">
            <div class="left">
              <div class="general-item">
                <p class="item-label">Product Description:</p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.productDescription) %>
                </p>
              </div>
              <div class="general-item">
                <p class="item-label">
                  <%= formValue.utils.parseFormValue(item.fobValue1) %>:
                </p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.fobCurrencyValue1) %>
                  <%= formValue.utils.parseFormValue(item.foBCurrency1) %>
                </p>
              </div>
            </div>
            <div class="right">
              <div class="general-item">
                <p class="item-label">HS Code:</p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.hsCode) %>
                </p>
              </div>
              <div class="general-item">
                <p class="item-label" style="visibility: hidden">HS Code:</p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.hsCodeDetails) %>
                </p>
              </div>
              <div class="general-item">
                <p class="item-label">Unit of Quantity :</p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.unitQuantity) %>
                </p>
              </div>
              <div class="general-item">
                <p class="item-label">Quantity:</p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.quantity) %>
                </p>
              </div>
            </div>
          </div>
        </div>
        <%})%>
      </div>

      <div class="material-description">
        <div class="material-group">
          <h3>Export L/C Information Group</h3>
        </div>

        <% formValue.ttPOScCmLCInformationContainer.map((item) => { %>
        <div>
          <div class="material-details" style="margin-top: 1rem">
            <h3>TT/ P.O/ SC/ CM/ L/C Information</h3>
          </div>
          <div class="border-box">
            <div class="left">
              <div class="general-item">
                <p class="item-label"><%= item.ttNo %>:</p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.ttNoInput) %>
                </p>
              </div>
              <div class="general-item">
                <p class="item-label">Issuing Bank:</p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.issuingBank) %>
                </p>
              </div>
              <div class="general-item">
                <p class="item-label">Issue Date:</p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.issueDate) %>
                </p>
              </div>
            </div>
            <div class="right">
              <div class="general-item">
                <p class="item-label"><%= item.ttNo %> Value:</p>
                <p class="item-value">
                  <%= item.ttvalueHidden %> <%= item.ttCurrencyValueHidden %>
                </p>
              </div>
              <div class="general-item">
                <p class="item-label">Type:</p>
                <p class="item-value"><%= item.typeOfLC %></p>
              </div>
              <div class="general-item">
                <p class="item-label">Expire Date :</p>
                <p class="item-value">
                  <%= formValue.utils.parseFormValue(item.expiryDate) %>
                </p>
              </div>
            </div>
          </div>
        </div>
        <%})%>
      </div>
    </div>
  </body>
</html>
