<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-size: 14px;
        }

        .main-page{
            background-repeat: no-repeat;          
            background-size: cover;               
            background-position: center;          
            background-image: url(data:image/jpeg;base64,);
    }

        .wrapper{
            min-height: 100vh;
            display: flex;
            flex-direction: column;
         }

        .content {
            flex: 1;
            margin: 0px 60px;
            margin-top: 180px;
            font-size: 16px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            font-weight: 600;
            margin: 0px 30px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            margin: 10px;
        }

        .fw-600 {
            font-weight: 600;
        }

        .title-1 {
            margin-top: 20px;
            font-size: 20px;
            font-weight: bold;
            text-align: center;
        }

        .title-2 {
            font-size: 20px;
            font-weight: bold;
            text-align: center;
        }

        .subtitle {
            font-size: 18px;
            margin: 10px 0;
            text-align: center;

        }

        .description {
            font-size: 16px;
            margin: 15px 0;
            text-align: center;
        }

        .list-and-sign{
            display: flex;
        }

        .signature{
            display: flex;
            flex-direction: column;
            width: 480px;
            margin-top: 20px;
            margin-right: 10px;
            justify-content: space-between;
        }

        .signature h4 {
          text-align: center;
        }

        .jnc-seal{
            text-align: center;
        }

        .sub-sections {
          display: flex;
          flex-direction: column;
          border: 1px solid lightgray;
          border-radius: 10px;
          padding: 5px;
          margin-top: 5px;
          margin-bottom: 5px;
        }

        .sign-seal-wrapper{
            display: flex;
            flex-wrap: wrap;
            justify-content: space-around;
        }

        .sign-seal{
            margin: 5px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .sign {
            width: 100px;
            height: 40px;
        }

        .seal {
            width: 120px;
            height: 60px;
        }

        .committee-list {
            display: flex;
            flex-direction: column;
            margin: 0px 10px;
            margin-top: 20px;
            width: 200px;
        }

        .single-member {
            margin-top: 5px;
            font-size: 14px;
        }

        .page-break {
            page-break-before: always;
        }
    </style>
</head>

<body>

    <!-- <h4 class="w-30 input-box">
        <%= formValue.response.userId %>
    </h4> -->


    <% 
        const membersCount = formValue?.response?.members?.length || 0; 
        const firstPageChunkSize=25;
        const chunkSize=30;
        const memberArray2D=[];
        let count=0;

        if(!membersCount) 
            memberArray2D.push([]);

        for (let i = 0;
            i < membersCount; 
            i +=(i===0 ? firstPageChunkSize :chunkSize)
        )
        {
            if(i === 0) {
                memberArray2D.push(formValue?.response?.members?.slice(i, i+firstPageChunkSize));
            } else {
                memberArray2D.push(formValue?.response?.members?.slice(i, i+chunkSize));
            }
        }

        const committee_map = {
            general:'সাধারণ',
            representative: 'প্রতিনিধি'
        }

        <!-- console.log('************** memberArray2D:',memberArray2D) -->
    %>

    <% memberArray2D.forEach((array1D, index2D)=>{ %> 
        <div class="main-page">
            <div class="wrapper">
            
                <div class="content">
    
                    <div class="header">
                        <div><span class="fw-600">স্মারক নং: </span><%= formValue.response.manuscript %></div>
                        <div><span class="fw-600">তারিখ: </span><%= formValue.response.date %></div>
                    </div>
            
                    <!-- kebol 1st page a thakbe nicher div ta -->
                    <% if(index2D===0) { %>
                        <div>
                            <div class="title-1"><%= formValue.response.name %></div>
                            <div class="title-2"><span><%= committee_map[formValue.response.committee_type] %></span> কমিটি</div>                        
    
                            <!-- <div class="subtitle">জুলাই'২৪ ছাত্র জনতার উদ্যোগে শহীদ পরিবার, আইনতদন্তকারীর সমর্থনে গঠিত</div> -->
                            <div class="subtitle"><%= formValue.response.description %></div>
                            
                            <div class="description"><span class="fw-600"><span>'<%= committee_map[formValue.response.committee_type] %></span> কমিটির'</span>তালিকা :</div>
                        </div>
                    <%}%>

                    <div class="list-and-sign">
                        <div class="committee-list">
                            <!-- inner loop ta khali eikhane cholbe -->
                            <% array1D?.forEach((item, idx)=>{ %>
                                <span class="single-member">
                                    <%= formValue?.utils?.convertToBengali(count+=1) %>.
                                    <span><%= item?.name %> </span> 
                                </span> 
                            <% }) %>
                        </div>

                        <div class="signature">

                            <!-- jnc seal -->
                            <div class="jnc-seal">
                                <img 
                                    src= "<%= formValue?.utils?.logoSealTrans %>" 
                                    alt="jnc-logo"
                                    width="120" 
                                    height="120"
                                />
                            </div>

                            <!-- suparish krome -->
                            <div class="sub-sections">
                                <h4>সুপারিশক্রমে</h4>

                                <div class="sign-seal-wrapper">
                                    <div class="sign-seal">
                                        <img 
                                            src= "<%= formValue?.utils?.signatureImg %>" 
                                            alt="sign"
                                            class="sign"
                                        />

                                        <img 
                                            src= "<%= formValue?.utils?.nasirSealTrans %>" 
                                            alt="seal"
                                            class="seal"
                                        />
                                    </div>

                                    <div class="sign-seal">
                                        <img 
                                            src= "<%= formValue?.utils?.signatureImg %>" 
                                            alt="sign"
                                            class="sign"
                                        />

                                        <img 
                                            src= "<%= formValue?.utils?.nasirSealTrans %>" 
                                            alt="seal"
                                            class="seal"
                                        />
                                    </div>
                                </div>
                            </div>

                            <!-- onumodon krome -->
                            <div class="sub-sections">
                                <h4>অনুমোদনক্রমে</h4>

                                <div class="sign-seal-wrapper">
                                    <div class="sign-seal">

                                        <img 
                                            src= "<%= formValue?.utils?.signatureImg %>" 
                                            alt="sign"
                                            class="sign"
                                        />
                                        
                                        <img 
                                            src= "<%= formValue?.utils?.nasirSealTrans %>" 
                                            alt="seal"
                                            class="seal"
                                        />
                                    </div>

                                    <div class="sign-seal">
                                        <img 
                                            src= "<%= formValue?.utils?.signatureImg %>" 
                                            alt="sign"
                                            class="sign"
                                        />

                                        <img 
                                            src= "<%= formValue?.utils?.akhterSealTrans %>" 
                                            alt="jnc-logo"
                                            class="seal"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <% if(index2D !==memberArray2D.length - 1) {%>
                    <div class="page-break"></div>
                <%}%> 
            </div>
        </div>
        
    <% }) %>
</body>

</html>